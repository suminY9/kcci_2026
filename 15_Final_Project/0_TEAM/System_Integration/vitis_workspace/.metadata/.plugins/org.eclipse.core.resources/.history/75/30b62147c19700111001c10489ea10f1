static void load_weight_layer(
    uint32_t layer,
    const uint8_t* weights,
    uint32_t count
)
{

    Xil_Out32(
        CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_LAYER_OFFSET,
        layer
    );

    for (uint32_t addr = 0; addr < count; ++addr) {
        // BRAM Write Address
        Xil_Out32(
            CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_ADDR_OFFSET,
            addr
        );

        // 8-bit Weight Data
        Xil_Out32(
            CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_DATA_OFFSET,
            static_cast<uint32_t>(weights[addr])
        );

        // �� Ŭ�� ���� �ش� Layer�� Write Enable �߻�
        Xil_Out32(
            CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_WRITE_OFFSET,
            1U
        );
    }
}

static void load_w5_padded(const uint8_t* weights)
{
    Xil_Out32(
        CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_LAYER_OFFSET,
        5U
    );

    uint32_t bram_addr = 0;
    for (uint32_t node = 0; node < 10; ++node) {
        // ���� ����ġ 84����Ʈ ����
        for (uint32_t i = 0; i < 84; ++i) {
            Xil_Out32(CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_ADDR_OFFSET, bram_addr++);
            Xil_Out32(CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_DATA_OFFSET, static_cast<uint32_t>(weights[node * 84 + i]));
            Xil_Out32(CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_WRITE_OFFSET, 1U);
        }
        // Zero-Padding 4����Ʈ ���� (�� 88����Ʈ ��Ʈ���̵� ����)
        for (uint32_t p = 0; p < 4; ++p) {
            Xil_Out32(CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_ADDR_OFFSET, bram_addr++);
            Xil_Out32(CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_DATA_OFFSET, 0U);
            Xil_Out32(CNN_WEIGHT_BASE_ADDR + CNN_WEIGHT_WRITE_OFFSET, 1U);
        }
    }
}

