void pipeline_mode_change(
    AXI_VDMA<ScuGicInterruptController>& vdma_driver,
    OV5640& cam,
    VideoOutput& vid,
    Resolution res,
    OV5640_cfg::mode_t mode
)
{
    // Bring up input pipeline back-to-front
    {
        vdma_driver.resetWrite();

        MIPI_CSI_2_RX_mWriteReg(
            XPAR_MIPI_CSI_2_RX_0_S_AXI_LITE_BASEADDR,
            CR_OFFSET,
            (CR_RESET_MASK & ~CR_ENABLE_MASK)
        );

        MIPI_D_PHY_RX_mWriteReg(
            MIPI_DPHY_BASE_ADDR,
            CR_OFFSET,
            (CR_RESET_MASK & ~CR_ENABLE_MASK)
        );

        cam.reset();
    }

    {
        vdma_driver.configureWrite(
            timing[static_cast<int>(res)].h_active,
            timing[static_cast<int>(res)].v_active
        );

        // Set Gamma correction factor to 1/1.8
        Xil_Out32(GAMMA_BASE_ADDR, 3);

        // TODO CSI-2, D-PHY config here
        cam.init();
    }

    {
        vdma_driver.enableWrite();

        MIPI_CSI_2_RX_mWriteReg(
            XPAR_MIPI_CSI_2_RX_0_S_AXI_LITE_BASEADDR,
            CR_OFFSET,
            CR_ENABLE_MASK
        );

        MIPI_D_PHY_RX_mWriteReg(
            MIPI_DPHY_BASE_ADDR,
            CR_OFFSET,
            CR_ENABLE_MASK
        );

        cam.set_mode(mode);
        cam.set_awb(OV5640_cfg::awb_t::AWB_ADVANCED);
    }

    // Bring up output pipeline back-to-front
    {
        vid.reset();
        vdma_driver.resetRead();
    }

    {
        vid.configure(res);

        vdma_driver.configureRead(
            timing[static_cast<int>(res)].h_active,
            timing[static_cast<int>(res)].v_active
        );
    }

    {
        vid.enable();
        vdma_driver.enableRead();
    }
}


static void dump_frame_debug_bram(void)
{
    xil_printf("FBUF_BEGIN,128\r\n");

    for (u32 addr = 0; addr < 128U; ++addr) {
        u32 data = Xil_In32(
            DEBUG_BRAM_BASE + (addr * 4U)
        );

        xil_printf(
            "FBUF,%d,0x%08x\r\n",
            (int)addr,
            (unsigned int)data
        );
    }

    xil_printf("FBUF_END,128\r\n");
}


static void dump_pixel_snapshot(void)
{
    xil_printf("PBUF_BEGIN,128\r\n");

    for (uint32_t addr = 0; addr < 128U; ++addr) {
        uint32_t ctrl =
            WEIGHT_DBG_ENABLE_BIT |
            (6U << WEIGHT_DBG_LAYER_SHIFT) |
            (addr & 0x7FU);

        Xil_Out32(WEIGHT_DBG_GPIO_BASE + GPIO_CH1_DATA_OFFSET, ctrl);

        uint32_t status = 0;
        int timeout = WEIGHT_DBG_POLL_LIMIT;
        do {
            status = Xil_In32(WEIGHT_DBG_GPIO_BASE + GPIO_CH2_DATA_OFFSET);
        } while (!(status & 0x80000000U) && --timeout > 0);

        uint32_t data = status & 0x7FFFFFFFU;  //

        xil_printf(
            "PBUF,%d,0x%08x\r\n",
            (int)addr,
            (unsigned int)data
        );
    }

    Xil_Out32(WEIGHT_DBG_GPIO_BASE + GPIO_CH1_DATA_OFFSET, 0U);

    xil_printf("PBUF_END,128\r\n");
}


static void dbg_settle_delay(void)
{
    for (volatile int i = 0; i < 50; ++i) {
    }
}


static void dump_bram_word_layer(uint32_t layer, const char* tag, uint32_t row_count)
{
    xil_printf("%s_BEGIN,%d\r\n", tag, (int)row_count);

    for (uint32_t row = 0; row < row_count; ++row) {
        uint32_t ctrl_lo =
            WEIGHT_DBG_ENABLE_BIT | (layer << WEIGHT_DBG_LAYER_SHIFT) | (row & 0x7FU);
        Xil_Out32(WEIGHT_DBG_GPIO_BASE + GPIO_CH1_DATA_OFFSET, ctrl_lo);
        dbg_settle_delay();
        uint32_t lo = Xil_In32(WEIGHT_DBG_GPIO_BASE + GPIO_CH2_DATA_OFFSET);

        uint32_t ctrl_hi = ctrl_lo | (1U << 7);
        Xil_Out32(WEIGHT_DBG_GPIO_BASE + GPIO_CH1_DATA_OFFSET, ctrl_hi);
        dbg_settle_delay();
        uint32_t hi = Xil_In32(WEIGHT_DBG_GPIO_BASE + GPIO_CH2_DATA_OFFSET);

        xil_printf(
            "%s,%d,0x%08x%08x\r\n",
            tag, (int)row, (unsigned int)hi, (unsigned int)lo
        );
    }

    Xil_Out32(WEIGHT_DBG_GPIO_BASE + GPIO_CH1_DATA_OFFSET, 0U);
    xil_printf("%s_END,%d\r\n", tag, (int)row_count);
}


static void dump_conv1_snapshot(void)
{
    xil_printf("CONV1_BEGIN,6,196\r\n");

    for (uint32_t ch = 0; ch < 6U; ++ch) {
        for (uint32_t row = 0; row < 196U; ++row) {
            uint32_t addr = (ch << 8) | (row & 0xFFU);
            uint32_t ctrl =
                WEIGHT_DBG_ENABLE_BIT | (4U << WEIGHT_DBG_LAYER_SHIFT) | (addr & 0x7FFU);

            Xil_Out32(WEIGHT_DBG_GPIO_BASE + GPIO_CH1_DATA_OFFSET, ctrl);
            dbg_settle_delay();
            uint32_t status = Xil_In32(WEIGHT_DBG_GPIO_BASE + GPIO_CH2_DATA_OFFSET);

            xil_printf(
                "CONV1,%d,%d,0x%02x\r\n",
                (int)ch, (int)row, (unsigned int)(status & 0xFFU)
            );
        }
    }

    Xil_Out32(WEIGHT_DBG_GPIO_BASE + GPIO_CH1_DATA_OFFSET, 0U);
    xil_printf("CONV1_END,6,196\r\n");
}


static void dump_intermediate_snapshots(void)
{
    dump_conv1_snapshot();               // BRAM_CONV1: Conv1+Pool1
    dump_bram_word_layer(1U, "CONV2", 50U);  // BRAM_CONV2: Conv2+Pool2
    dump_bram_word_layer(2U, "CONV3", 15U);  // BRAM_CONV3: Conv3
    dump_bram_word_layer(3U, "FC1", 11U);    // BRAM_FC   : FC1
}

static void print_debug_snapshot(void)
{
    u32 vga_status;
    u32 frame_data;
    u32 cnn_status;
    u32 uart_status;

    vga_status = Xil_In32(
        VGA_DEBUG_GPIO_BASE + GPIO_CH1_DATA_OFFSET
    );

    frame_data = Xil_In32(
        VGA_DEBUG_GPIO_BASE + GPIO_CH2_DATA_OFFSET
    );

    cnn_status = Xil_In32(
        CNN_UART_DEBUG_GPIO_BASE + GPIO_CH1_DATA_OFFSET
    );

    uart_status = Xil_In32(
        CNN_UART_DEBUG_GPIO_BASE + GPIO_CH2_DATA_OFFSET
    );

    /* AXI GPIO 0, Channel 1 */
    u32 sr04_state    =  vga_status        & 0x07U;
    u32 vga_done      = (vga_status >> 3)  & 0x01U;
    u32 vga_done_seen = (vga_status >> 4)  & 0x01U;
    u32 line_cnt      = (vga_status >> 5)  & 0x1FU;
    u32 bit_cnt       = (vga_status >> 10) & 0x1FU;
    u32 pos_cnt       = (vga_status >> 15) & 0x03U;
    u32 frame_we      = (vga_status >> 17) & 0x01U;
    u32 frame_addr    = (vga_status >> 18) & 0xFFU;
    u32 vga_done_cnt  = (vga_status >> 26) & 0x3FU;

    /* AXI GPIO 1, Channel 1 */
    u32 inf_data      =  cnn_status        & 0xFFFFU;
    u32 inf_done_cnt  = (cnn_status >> 16) & 0xFFU;
    u32 cnn_done_cnt  = (cnn_status >> 24) & 0xFFU;

    /* AXI GPIO 1, Channel 2 */
    u32 uart_tx        =  uart_status        & 0x01U;
    u32 uart_busy      = (uart_status >> 1)  & 0x01U;
    u32 uart_valid     = (uart_status >> 2)  & 0x01U;
    u32 inf_done_seen  = (uart_status >> 3)  & 0x01U;
    u32 cnn_done_seen  = (uart_status >> 4)  & 0x01U;
    u32 cnn_ctrl_state = (uart_status >> 5)  & 0x03U;
    u32 cnn_ctrl_cnt   = (uart_status >> 8)  & 0x03U;
    u32 uart_byte      = (uart_status >> 16) & 0xFFU;
    u32 uart_byte_cnt  = (uart_status >> 24) & 0xFFU;

    xil_printf(
        "DBG,"
        "SR04=%d,"
        "VGA_DONE=%d,"
        "VGA_SEEN=%d,"
        "VGA_COUNT=%d,"
        "LINE=%d,"
        "BIT=%d,"
        "POS=%d,"
        "FRAME_WE=%d,"
        "FRAME_ADDR=%d,"
        "FRAME_DATA=0x%08x,"
        "CNN_SEEN=%d,"
        "CNN_COUNT=%d,"
        "INF_SEEN=%d,"
        "INF_COUNT=%d,"
        "INF_DATA=%d,"
        "CTRL_STATE=%d,"
        "CTRL_CNT=%d,"
        "UART_BYTE=%d,"
        "UART_VALID=%d,"
        "UART_BUSY=%d,"
        "UART_TX=%d,"
        "UART_COUNT=%d\r\n",
        (int)sr04_state,
        (int)vga_done,
        (int)vga_done_seen,
        (int)vga_done_cnt,
        (int)line_cnt,
        (int)bit_cnt,
        (int)pos_cnt,
        (int)frame_we,
        (int)frame_addr,
        (unsigned int)frame_data,
        (int)cnn_done_seen,
        (int)cnn_done_cnt,
        (int)inf_done_seen,
        (int)inf_done_cnt,
        (int)inf_data,
        (int)cnn_ctrl_state,
        (int)cnn_ctrl_cnt,
        (int)uart_byte,
        (int)uart_valid,
        (int)uart_busy,
        (int)uart_tx,
        (int)uart_byte_cnt
    );
}

int main()
{
    init_platform();

    load_all_cnn_weights();

    ScuGicInterruptController irpt_ctl(IRPT_CTL_DEVID);

    PS_GPIO<ScuGicInterruptController> gpio_driver(
        GPIO_DEVID,
        irpt_ctl,
        GPIO_IRPT_ID
    );

    PS_IIC<ScuGicInterruptController> iic_driver(
        CAM_I2C_DEVID,
        irpt_ctl,
        CAM_I2C_IRPT_ID,
        CAM_I2C_SCLK_RATE
    );

    OV5640 cam(iic_driver, gpio_driver);

    AXI_VDMA<ScuGicInterruptController> vdma_driver(
        VDMA_DEVID,
        MEM_BASE_ADDR,
        irpt_ctl,
        VDMA_MM2S_IRPT_ID,
        VDMA_S2MM_IRPT_ID
    );

    VideoOutput vid(
        XPAR_VTC_0_DEVICE_ID,
        XPAR_VIDEO_DYNCLK_DEVICE_ID
    );

    // 720p
    pipeline_mode_change(
        vdma_driver,
        cam,
        vid,
//		Resolution::R640_480_60_NN,
//		OV5640_cfg::mode_t::MODE_VGA_640_480_30fps
		Resolution::R1280_720_60_PP,
		    OV5640_cfg::mode_t::MODE_720P_1280_720_60fps
    );

    xil_printf("Video init done.\r\n");

    // Liquid lens control
    uint8_t read_char0 = 0;
    uint8_t read_char1 = 0;
    uint8_t read_char2 = 0;
    uint8_t read_char4 = 0;
    uint8_t read_char5 = 0;

    uint16_t reg_addr;
    uint8_t reg_value;

    while (1) {
        xil_printf("\r\n\r\n\r\nPcam 5C MAIN OPTIONS\r\n");
        xil_printf(
            "\r\nPlease press the key corresponding to the desired option:"
        );
        xil_printf("\r\n  a. Change Resolution");
        xil_printf("\r\n  b. Change Liquid Lens Focus");
        xil_printf("\r\n  d. Change Image Format (Raw or RGB)");
        xil_printf("\r\n  e. Write a Register Inside the Image Sensor");
        xil_printf("\r\n  f. Read a Register Inside the Image Sensor");
        xil_printf("\r\n  g. Change Gamma Correction Factor Value");
        xil_printf("\r\n  h. Change AWB Settings\r\n\r\n");
        xil_printf("\r\n  i. Print Debug Snapshot\r\n\r\n");
        xil_printf("\r\n  p. Dump Frame Buffer\r\n\r\n");
        xil_printf("\r\n  r. Dump Pixel Snapshot (CNN read-side)\r\n\r\n");
        xil_printf("\r\n  c. Dump CONV/FC Intermediate BRAMs\r\n\r\n");

        read_char0 = getchar();
        getchar();

        xil_printf("Read: %d\r\n", read_char0);

        if (read_char0 == 'i') {
            print_debug_snapshot();
            continue;
        }

        if (read_char0 == 'p') {
            dump_frame_debug_bram();
            continue;
        }

        if (read_char0 == 'r') {
            dump_pixel_snapshot();
            continue;
        }

        if (read_char0 == 'c') {
            dump_intermediate_snapshots();
            continue;
        }

        switch (read_char0) {
        case 'a':
            xil_printf(
                "\r\n  Please press the key corresponding to the desired resolution:"
            );
            xil_printf("\r\n    1. 1280 x 720, 60fps");
            xil_printf("\r\n    2. 1920 x 1080, 15fps");
            xil_printf("\r\n    3. 1920 x 1080, 30fps");
            xil_printf("\r\n    4. 640 x 480, 60fps");

            read_char1 = getchar();
            getchar();

            xil_printf("\r\nRead: %d", read_char1);

            switch (read_char1) {
            case '1':
                pipeline_mode_change(
                    vdma_driver,
                    cam,
                    vid,
                    Resolution::R1280_720_60_PP,
                    OV5640_cfg::mode_t::MODE_720P_1280_720_60fps
                );

                xil_printf("Resolution change done.\r\n");
                break;

            case '2':
                pipeline_mode_change(
                    vdma_driver,
                    cam,
                    vid,
                    Resolution::R1920_1080_30_PP,
                    OV5640_cfg::mode_t::MODE_1080P_1920_1080_15fps
                );

                xil_printf("Resolution change done.\r\n");
                break;

            case '3':
                pipeline_mode_change(
                    vdma_driver,
                    cam,
                    vid,
                    Resolution::R1920_1080_30_PP,
                    OV5640_cfg::mode_t::MODE_1080P_1920_1080_30fps
                );

                xil_printf("Resolution change done.\r\n");
                break;

            case '4':
                pipeline_mode_change(
                    vdma_driver,
                    cam,
                    vid,
                    Resolution::R640_480_60_NN,
                    OV5640_cfg::mode_t::MODE_VGA_640_480_60fps
                );

                xil_printf("Resolution change done.\r\n");
                break;

            default:
                xil_printf(
                    "\r\n  Selection is outside the available options! Please retry..."
                );
                break;
            }

            break;

        case 'b':
            xil_printf(
                "\r\n\r\nPlease enter value of liquid lens register, "
                "in hex, with small letters: 0x"
            );

            // A, B, C,..., F need to be entered with small letters
            while (read_char1 < 48) {
                read_char1 = getchar();
            }

            while (read_char2 < 48) {
                read_char2 = getchar();
            }

            getchar();

            // Convert ASCII digit to a value between 0 and 9
            if (read_char1 <= 57) {
                read_char1 -= 48;
            }
            // Convert lowercase ASCII letter to a value between 10 and 15
            else {
                read_char1 -= 87;
            }

            if (read_char2 <= 57) {
                read_char2 -= 48;
            }
            else {
                read_char2 -= 87;
            }

            cam.writeRegLiquid(
                static_cast<uint8_t>(16 * read_char1 + read_char2)
            );

            xil_printf(
                "\r\nWrote to liquid lens controller: %x",
                static_cast<uint8_t>(16 * read_char1 + read_char2)
            );

            break;

        case 'd':
            xil_printf(
                "\r\n  Please press the key corresponding to the desired setting:"
            );
            xil_printf(
                "\r\n    1. Select image format to be RGB, output still Raw"
            );
            xil_printf(
                "\r\n    2. Select image format & output to both be Raw"
            );

            read_char1 = getchar();
            getchar();

            xil_printf("\r\nRead: %d", read_char1);

            switch (read_char1) {
            case '1':
                cam.set_isp_format(
                    OV5640_cfg::isp_format_t::ISP_RGB
                );

                xil_printf("Settings change done.\r\n");
                break;

            case '2':
                cam.set_isp_format(
                    OV5640_cfg::isp_format_t::ISP_RAW
                );

                xil_printf("Settings change done.\r\n");
                break;

            default:
                xil_printf(
                    "\r\n  Selection is outside the available options! Please retry..."
                );
                break;
            }

            break;

        case 'e':
            xil_printf(
                "\r\nPlease enter address of image sensor register, "
                "in hex, with small letters: \r\n"
            );

            // A, B, C,..., F need to be entered with small letters
            while (read_char1 < 48) {
                read_char1 = getchar();
            }

            while (read_char2 < 48) {
                read_char2 = getchar();
            }

            while (read_char4 < 48) {
                read_char4 = getchar();
            }

            while (read_char5 < 48) {
                read_char5 = getchar();
            }

            getchar();

            if (read_char1 <= 57) {
                read_char1 -= 48;
            }
            else {
                read_char1 -= 87;
            }

            if (read_char2 <= 57) {
                read_char2 -= 48;
            }
            else {
                read_char2 -= 87;
            }

            if (read_char4 <= 57) {
                read_char4 -= 48;
            }
            else {
                read_char4 -= 87;
            }

            if (read_char5 <= 57) {
                read_char5 -= 48;
            }
            else {
                read_char5 -= 87;
            }

            reg_addr =
                16 * (
                    16 * (
                        16 * read_char1 + read_char2
                    ) + read_char4
                ) + read_char5;

            xil_printf(
                "Desired Register Address: %x\r\n",
                reg_addr
            );

            read_char1 = 0;
            read_char2 = 0;

            xil_printf(
                "\r\nPlease enter value of image sensor register, "
                "in hex, with small letters: \r\n"
            );

            while (read_char1 < 48) {
                read_char1 = getchar();
            }

            while (read_char2 < 48) {
                read_char2 = getchar();
            }

            getchar();

            if (read_char1 <= 57) {
                read_char1 -= 48;
            }
            else {
                read_char1 -= 87;
            }

            if (read_char2 <= 57) {
                read_char2 -= 48;
            }
            else {
                read_char2 -= 87;
            }

            reg_value = 16 * read_char1 + read_char2;

            xil_printf(
                "Desired Register Value: %x\r\n",
                reg_value
            );

            cam.writeReg(reg_addr, reg_value);

            xil_printf("Register write done.\r\n");
            break;

        case 'f':
            xil_printf(
                "Please enter address of image sensor register, "
                "in hex, with small letters: \r\n"
            );

            while (read_char1 < 48) {
                read_char1 = getchar();
            }

            while (read_char2 < 48) {
                read_char2 = getchar();
            }

            while (read_char4 < 48) {
                read_char4 = getchar();
            }

            while (read_char5 < 48) {
                read_char5 = getchar();
            }

            getchar();

            if (read_char1 <= 57) {
                read_char1 -= 48;
            }
            else {
                read_char1 -= 87;
            }

            if (read_char2 <= 57) {
                read_char2 -= 48;
            }
            else {
                read_char2 -= 87;
            }

            if (read_char4 <= 57) {
                read_char4 -= 48;
            }
            else {
                read_char4 -= 87;
            }

            if (read_char5 <= 57) {
                read_char5 -= 48;
            }
            else {
                read_char5 -= 87;
            }

            reg_addr =
                16 * (
                    16 * (
                        16 * read_char1 + read_char2
                    ) + read_char4
                ) + read_char5;

            xil_printf(
                "Desired Register Address: %x\r\n",
                reg_addr
            );

            cam.readReg(reg_addr, reg_value);

            xil_printf(
                "Value of Desired Register: %x\r\n",
                reg_value
            );

            break;

        case 'g':
            xil_printf(
                "  Please press the key corresponding "
                "to the desired Gamma factor:\r\n"
            );
            xil_printf("    1. Gamma Factor = 1\r\n");
            xil_printf("    2. Gamma Factor = 1/1.2\r\n");
            xil_printf("    3. Gamma Factor = 1/1.5\r\n");
            xil_printf("    4. Gamma Factor = 1/1.8\r\n");
            xil_printf("    5. Gamma Factor = 1/2.2\r\n");

            read_char1 = getchar();
            getchar();

            xil_printf("Read: %d\r\n", read_char1);

            // Convert from ASCII to numeric
            read_char1 = read_char1 - 48;

            if ((read_char1 > 0) && (read_char1 < 6)) {
                Xil_Out32(
                    GAMMA_BASE_ADDR,
                    read_char1 - 1
                );

                xil_printf("Gamma value changed.\r\n");
            }
            else {
                xil_printf(
                    "  Selection is outside the available options! "
                    "Please retry...\r\n"
                );
            }

            break;

        case 'h':
            xil_printf(
                "  Please press the key corresponding "
                "to the desired AWB change:\r\n"
            );
            xil_printf("    1. Enable Advanced AWB\r\n");
            xil_printf("    2. Enable Simple AWB\r\n");
            xil_printf("    3. Disable AWB\r\n");

            read_char1 = getchar();
            getchar();

            xil_printf("Read: %d\r\n", read_char1);

            switch (read_char1) {
            case '1':
                cam.set_awb(
                    OV5640_cfg::awb_t::AWB_ADVANCED
                );

                xil_printf("Enabled Advanced AWB\r\n");
                break;

            case '2':
                cam.set_awb(
                    OV5640_cfg::awb_t::AWB_SIMPLE
                );

                xil_printf("Enabled Simple AWB\r\n");
                break;

            case '3':
                cam.set_awb(
                    OV5640_cfg::awb_t::AWB_DISABLED
                );

                xil_printf("Disabled AWB\r\n");
                break;

            default:
                xil_printf(
                    "  Selection is outside the available options! "
                    "Please retry...\r\n"
                );
                break;
            }

            break;

        default:
            xil_printf(
                "  Selection is outside the available options! "
                "Please retry...\r\n"
            );
            break;
        }

        read_char1 = 0;
        read_char2 = 0;
        read_char4 = 0;
        read_char5 = 0;
    }

    cleanup_platform();

    return 0;
}
